# Copy to qa/e2e/.env.e2e and fill in. That file is gitignored; keep it out of commits.

# --- Target -----------------------------------------------------------------
# Local:      http://localhost:3000
# Production: https://app.therapyflow.pro
E2E_BASE_URL=http://localhost:3000

# --- Super admin ------------------------------------------------------------
E2E_SUPERADMIN_USER=
E2E_SUPERADMIN_PASSWORD=

# --- Mailbox the suite reads codes from (real IMAP, no application backdoor) --
# Every run books its own plus-address, e.g. you+e2e-1732.. @gmail.com.
E2E_MAILBOX_ADDRESS=
E2E_IMAP_PASSWORD=
E2E_IMAP_HOST=imap.gmail.com
E2E_IMAP_PORT=993
# Defaults to E2E_MAILBOX_ADDRESS; set only if the IMAP login differs.
#E2E_IMAP_USER=

# --- New organisation admin -------------------------------------------------
# The suite prefers the temporary password from the onboarding email. This is the
# fallback and must match the backend's SUPERADMIN_ONBOARDING_DEFAULT_ADMIN_PASSWORD.
E2E_ORG_ADMIN_PASSWORD=
# Optional. When set, the suite also enrolls SMS as a second factor. Needs a
# Twilio-deliverable number; without it the SMS step reports as skipped.
#E2E_ADMIN_PHONE=+14155551234

# --- Organisation shape -----------------------------------------------------
E2E_PLAN_NAME=Enterprise
E2E_BILLING_CYCLE=Monthly
E2E_TRIAL_DAYS=14
E2E_TIMEZONE=America/Toronto
#E2E_REGION=
#E2E_DATA_RESIDENCY=

# --- Run behaviour ----------------------------------------------------------
# 0 keeps the organisation after a green run (default deletes it).
#E2E_CLEANUP=0
# 1 runs with a visible browser.
#E2E_HEADED=1
#E2E_MAIL_TIMEOUT_MS=180000
